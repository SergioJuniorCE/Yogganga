{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["EXPO_PUBLIC_SERVER_URL"],
  "globalPassThroughEnv": [
    "PORT",
    "DATA_DIR",
    "MANGA_INVITE_CODE",
    "POLL_HOURS",
    "LANGUAGES",
    "QUALITY",
    "DOWNLOAD_CONCURRENCY"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "outputs": []
    }
  }
}
