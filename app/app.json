{
  "expo": {
    "name": "Yogganga",
    "slug": "yogganga",
    "version": "0.1.0",
    "scheme": "yogganga",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-sqlite",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.yogganga.reader"
    },
    "android": {
      "package": "dev.yogganga.reader",
      "edgeToEdgeEnabled": true
    }
  }
}
