# Port the API listens on
PORT=8787

# Where the SQLite database and downloaded images live
DATA_DIR=./data

# Invite code friends need to create an account.
# The first account can always be created without it; after that, registration
# is closed unless this is set.
MANGA_INVITE_CODE=

# How often to check followed series for new chapters, in hours
POLL_HOURS=6

# Translated languages to track, comma separated
LANGUAGES=en

# "data" = full quality, "data-saver" = smaller files
QUALITY=data

# Chapters downloaded in parallel
DOWNLOAD_CONCURRENCY=2
