{
  "name": "yogganga",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:server": "turbo run dev --filter=@yogganga/server",
    "dev:app": "pnpm --filter @yogganga/app dev",
    "start": "turbo run start --filter=@yogganga/server",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
